[Unit]
Description=Omapasskey TPM passkeys (FIDO2 authenticator)
Documentation=https://github.com/Divanyx/omapasskey
After=tpm2.target systemd-udevd.service
Wants=tpm2.target

[Service]
Type=notify
ExecStartPre=+-/usr/bin/modprobe -q uhid
ExecStart=/usr/local/lib/omapasskey/omapasskeyd
# systemd opens /dev/uhid for the service; the service itself cannot.
OpenFile=/dev/uhid:uhid
User=omapasskey
Group=omapasskey
# tss: the TPM resource manager. input: physical keyboards, opened only while
# a confirmation is pending.
SupplementaryGroups=tss input
StateDirectory=omapasskey
StateDirectoryMode=0700
RuntimeDirectory=omapasskey
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=2
LimitCORE=0

# Sandbox: no capabilities, no network, no other devices, read-only system.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
