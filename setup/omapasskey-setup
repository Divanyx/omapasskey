#!/usr/bin/env bash
# omapasskey-setup — install, update or remove the Omapasskey system service.
#
#   omapasskey-setup install [--from-source]   install or update (asks for sudo)
#   omapasskey-setup uninstall [--purge]        remove the service (keeps passkeys
#                                               unless --purge)
#   omapasskey-setup status                     show what is installed
#
# The plugin runs this in a terminal when you click the bar icon. It installs
# two release binaries whose SHA-256 sums are pinned in this repository
# (setup/SHA256SUMS), or builds them from this checkout with --from-source.
set -euo pipefail

VERSION="1.2.1"
LIBDIR=/usr/local/lib/omapasskey
CLI=/usr/local/bin/omapasskey
UNIT=/etc/systemd/system/omapasskeyd.service
SYSUSERS=/etc/sysusers.d/omapasskey.conf
MODULES=/etc/modules-load.d/omapasskey.conf
CONFDIR=/etc/omapasskey
STATEDIR=/var/lib/omapasskey

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
checkout="$(dirname "$here")"
tmpdir=""
trap 'if [[ -n $tmpdir ]]; then rm -rf "$tmpdir"; fi' EXIT

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die() { printf '\n\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

confirm() {
  local answer
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]]
}

arch() {
  case "$(uname -m)" in
    x86_64) echo amd64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) die "unsupported CPU architecture $(uname -m)" ;;
  esac
}

preflight() {
  [[ $(uname -s) == Linux ]] || die "Omapasskey needs Linux."
  [[ -e /dev/tpmrm0 ]] || die "No TPM 2.0 found (/dev/tpmrm0). Enable the TPM (fTPM, PTT or a discrete TPM) in the firmware setup and try again."
  local systemd_version
  systemd_version="$(systemctl --version | awk 'NR==1 {print $2}')"
  [[ ${systemd_version%%.*} -ge 254 ]] || die "systemd 254 or newer is needed (found $systemd_version)."
  command -v sudo >/dev/null || die "sudo is needed."
  command -v sha256sum >/dev/null || die "sha256sum is needed."
}

# Verifies $1/NAME against the pinned sums. Returns non-zero on mismatch.
verify() {
  local dir="$1" name="$2" want got
  want="$(awk -v f="$name" '$2 == f {print $1}' "$here/SHA256SUMS")"
  [[ -n $want ]] || die "no pinned checksum for $name in setup/SHA256SUMS"
  got="$(sha256sum "$dir/$name" | awk '{print $1}')"
  [[ $got == "$want" ]]
}

fetch_release() {
  local dir="$1" a name
  a="$(arch)"
  for name in "omapasskeyd-linux-$a" "omapasskey-linux-$a"; do
    echo "Downloading $name (v$VERSION) from GitHub"
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 \
      -o "$dir/$name" "https://github.com/Divanyx/omapasskey/releases/download/v${VERSION}/$name" \
      || die "download failed: $name"
    verify "$dir" "$name" || die "$name does not match its pinned SHA-256 sum. Nothing was installed."
    echo "  SHA-256 verified"
  done
  mv "$dir/omapasskeyd-linux-$a" "$dir/omapasskeyd"
  mv "$dir/omapasskey-linux-$a" "$dir/omapasskey"
}

build_source() {
  local dir="$1" a
  a="$(arch)"
  command -v go >/dev/null || die "--from-source needs the Go toolchain (go) on the PATH."
  echo "Building from $checkout"
  (
    cd "$checkout"
    export CGO_ENABLED=0 GOFLAGS=-mod=readonly
    go build -trimpath -buildvcs=false -ldflags "-s -w -buildid= -X main.version=$VERSION" -o "$dir/omapasskeyd-linux-$a" ./cmd/omapasskeyd
    go build -trimpath -buildvcs=false -ldflags "-s -w -buildid= -X main.version=$VERSION" -o "$dir/omapasskey-linux-$a" ./cmd/omapasskey
  ) || die "build failed"
  if verify "$dir" "omapasskeyd-linux-$a" && verify "$dir" "omapasskey-linux-$a"; then
    echo "  Reproduced the published release bit for bit."
  else
    echo "  Your build differs from the published release (another Go toolchain?). Installing your build."
  fi
  mv "$dir/omapasskeyd-linux-$a" "$dir/omapasskeyd"
  mv "$dir/omapasskey-linux-$a" "$dir/omapasskey"
}

wait_ready() {
  local _
  for _ in $(seq 1 50); do
    [[ -S /run/omapasskey/status.sock ]] && return 0
    sleep 0.1
  done
  return 1
}

do_install() {
  local from_source=0
  [[ ${1:-} == --from-source ]] && from_source=1
  preflight

  bold "Omapasskey $VERSION — TPM passkeys for this computer"
  cat <<'EOF'

This installs a small system service that browsers see as a USB security key.
Its keys are created inside your TPM and can never leave it. Every passkey
use needs your PIN and both Ctrl keys pressed on a physical keyboard.

It will install, with sudo:
  /usr/local/lib/omapasskey/omapasskeyd     the service (runs as user "omapasskey")
  /usr/local/bin/omapasskey                 the command-line tool
  /etc/systemd/system/omapasskeyd.service   sandboxed systemd unit
  /etc/sysusers.d, /etc/modules-load.d      its user, and the uhid kernel module
  /etc/omapasskey/omapasskey.conf           lets your desktop show its prompts
Passkeys will be stored TPM-wrapped and encrypted in /var/lib/omapasskey.
EOF
  echo
  confirm "Continue?" || { echo "Nothing was changed."; exit 1; }

  tmpdir="$(mktemp -d)"
  local tmp="$tmpdir"
  step "Getting the binaries"
  if ((from_source)); then build_source "$tmp"; else fetch_release "$tmp"; fi

  step "Installing (sudo)"
  local uid
  uid="$(id -u)"
  sudo install -d -m 0755 "$LIBDIR"
  sudo install -m 0755 -o root -g root "$tmp/omapasskeyd" "$LIBDIR/omapasskeyd"
  sudo install -m 0755 -o root -g root "$tmp/omapasskey" "$CLI"
  sudo install -m 0644 -o root -g root "$checkout/system/omapasskeyd.service" "$UNIT"
  sudo install -m 0644 -o root -g root "$checkout/system/omapasskey.sysusers" "$SYSUSERS"
  sudo install -m 0644 -o root -g root "$checkout/system/omapasskey.modules-load" "$MODULES"
  sudo install -d -m 0755 "$CONFDIR"
  if ! sudo test -f "$CONFDIR/omapasskey.conf"; then
    printf '%s\n' \
      "# Omapasskey — see https://github.com/Divanyx/omapasskey" \
      "# UIDs whose desktop may follow the service (prompts in the bar)." \
      "users = $uid" \
      "# Shortest PIN accepted (4-63 characters)." \
      "min_pin_length = 6" \
      "# Seconds to press the confirm keys before a request lapses (5-120)." \
      "presence_timeout = 30" | sudo tee "$CONFDIR/omapasskey.conf" >/dev/null
    sudo chmod 0644 "$CONFDIR/omapasskey.conf"
  fi
  sudo systemd-sysusers "$SYSUSERS"
  sudo modprobe uhid || true
  sudo systemctl daemon-reload
  sudo systemctl enable omapasskeyd.service >/dev/null 2>&1
  sudo systemctl reset-failed omapasskeyd.service 2>/dev/null || true
  if ! sudo systemctl restart omapasskeyd.service || ! wait_ready; then
    echo
    sudo journalctl -u omapasskeyd.service -b -n 15 --no-pager -o cat || true
    die "the service did not start (log above). Please report it: https://github.com/Divanyx/omapasskey/issues"
  fi
  echo "Service running."

  if ! sudo "$CLI" status --json | grep -q '"pinSet":true'; then
    step "Choose your passkey PIN"
    cat <<'EOF'
Browsers ask for this PIN every time a passkey is used. Use at least six
characters; letters and words are fine and much stronger than digits. After
eight wrong tries in a row the PIN is blocked, and only a reset (which erases
the passkeys) helps.
EOF
    sudo "$CLI" pin set
  fi

  step "Done"
  "$CLI" status || true
  cat <<'EOF'

Try it: open https://webauthn.io in Firefox, register, then sign in. Your
browser asks for the PIN, the Omapasskey prompt asks for both Ctrl keys.

Keep another way to sign in to every account (a second key or recovery
codes): passkeys made here live in this computer's TPM and cannot be copied.
EOF
}

do_uninstall() {
  local purge=0
  [[ ${1:-} == --purge ]] && purge=1
  bold "Removing the Omapasskey service"
  if ((purge)); then
    cat <<'EOF'
--purge also deletes /var/lib/omapasskey: every passkey stored here is gone
for good, and sites will no longer accept them.
EOF
    local answer
    read -r -p "Type 'delete all passkeys' to continue: " answer
    [[ $answer == "delete all passkeys" ]] || { echo "Nothing was changed."; exit 1; }
  else
    confirm "Remove the service? Your passkeys stay in $STATEDIR." || { echo "Nothing was changed."; exit 1; }
  fi
  sudo systemctl disable --now omapasskeyd.service 2>/dev/null || true
  sudo rm -f "$UNIT" "$CLI" "$SYSUSERS" "$MODULES"
  sudo rm -rf "$LIBDIR"
  sudo systemctl daemon-reload
  if ((purge)); then
    sudo rm -rf "$STATEDIR" "$CONFDIR"
    sudo userdel omapasskey 2>/dev/null || true
    echo "Service and passkeys removed."
  else
    echo "Service removed; passkeys kept in $STATEDIR and settings in $CONFDIR (reinstall to use them again)."
  fi
  echo "Remove the bar plugin with: omarchy plugin remove omapasskey"
}

do_status() {
  if [[ -x $LIBDIR/omapasskeyd ]]; then
    echo "Installed: $("$LIBDIR/omapasskeyd" -version) (setup script $VERSION)"
  else
    echo "Not installed. Run: $0 install"
    return 1
  fi
  systemctl --no-pager --lines=5 status omapasskeyd.service || true
  echo
  "$CLI" doctor || true
}

case "${1:-}" in
  install) shift; do_install "$@" ;;
  uninstall) shift; do_uninstall "$@" ;;
  status) do_status ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
